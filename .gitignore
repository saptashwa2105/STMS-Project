# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
!.env.example

# Database files
*.db
*.sqlite
*.sqlite3

# Node & package dependencies
node_modules/
npm-debug.log*

# Test logs & caches
.pytest_cache/
.coverage
htmlcov/
*.log

# Build outputs & exported binaries
build/

# Godot Engine Cache & Imports
.godot/
.import/

